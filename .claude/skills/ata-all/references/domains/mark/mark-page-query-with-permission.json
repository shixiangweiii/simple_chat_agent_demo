{
  "version": 1,
  "id": "ata::mark-page-query-with-permission",
  "description": "分页查询当前用户的收藏信息",
  "javaMethod": "com.alibaba.atasuper.client.v2.mark.MarkClientService#pageQueryWithPermission",
  "inputSchema": {
    "description": "分页查询当前用户的收藏信息",
    "properties": {
      "fieldName_0": {
        "description": "查询收藏参数",
        "properties": {
          "cid": {
            "description": "收藏分类id，见`mark-category-*`系列接口",
            "type": "number"
          },
          "currentPage": {
            "description": "当前页码",
            "type": "number"
          },
          "enableReturnCount": {
            "description": "是否返回总条数",
            "type": "boolean"
          },
          "oid": {
            "description": "收藏对象id",
            "type": "number"
          },
          "oidList": {
            "items": {
              "description": "收藏对象id列表",
              "type": "number"
            },
            "type": "array"
          },
          "orderByList": {
            "items": {
              "description": "排序的字段信息",
              "properties": {
                "direction": {
                  "description": "排序;ASC 顺序;DESC 倒序;",
                  "enum": [
                    "ASC",
                    "DESC"
                  ],
                  "type": "string"
                },
                "orderConditionName": {
                  "description": "排序字段名;ID 主键;CTIME 创建时间;",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "pageSize": {
            "description": "分页大小",
            "type": "number"
          },
          "type": {
            "description": "收藏对象类型;1 文章;（MarkTypeEnum，与 Java Byte 一致）",
            "type": "number"
          }
        },
        "type": "object"
      },
      "fieldName_1": {
        "description": "返回字段的选择器，可以返回一些额外字段，在选择器中没有的字段默认这个接口都会直接返回的，在用户没有特别说明的情况下选择器建议不传任何字段",
        "properties": {
          "ataObjectSelector": {
            "description": "选择object对象里面的字段",
            "properties": {
              "articleSelector": {
                "description": "选择objectArticle对象里面的字段",
                "properties": {
                  "articleRecommendList": {
                    "description": "翰林院推荐的列表",
                    "type": "boolean"
                  },
                  "articleRecommendListSelector": {
                    "description": "选择articleRecommendList对象里面的字段",
                    "properties": {
                      "user": {
                        "description": "用户详细信息",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "content": {
                    "description": "文章的详细内容信息，用户没有说明的情况下建议传false,每日超过查询次数会被限流",
                    "type": "boolean"
                  },
                  "currentUserMark": {
                    "description": "当前用户是否收藏",
                    "type": "boolean"
                  },
                  "hasVote": {
                    "description": "当前用户是否点赞",
                    "type": "boolean"
                  },
                  "markSelector": {
                    "description": "选择currentUserMark对象里面的字段",
                    "properties": {
                      "ataObjectSelector": {
                        "description": "选择object对象里面的字段",
                        "properties": {
                          "articleSelector": {
                            "description": "选择object对象里面objectArticle的字段",
                            "type": "object"
                          }
                        },
                        "type": "object"
                      },
                      "markCategory": {
                        "description": "收藏分类的详细信息",
                        "type": "boolean"
                      },
                      "object": {
                        "description": "收藏对象信息",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "recommendCount": {
                    "description": "被翰林院推荐的次数",
                    "type": "boolean"
                  },
                  "user": {
                    "description": "用户详细信息",
                    "type": "boolean"
                  },
                  "voteReasonList": {
                    "description": "当前用户点赞的原因",
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "markCategory": {
            "description": "收藏分类",
            "type": "boolean"
          },
          "object": {
            "description": "收藏对象信息",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "fieldName_0"
    ],
    "type": "object"
  },
  "outputSchema": {
    "description": "AtaPageResult<MarkClientDTO> 收藏分页",
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "是否成功"
      },
      "errorCode": {
        "type": "string",
        "description": "错误编码"
      },
      "errorMsg": {
        "type": "string",
        "description": "错误信息"
      },
      "traceId": {
        "type": "string",
        "description": "追踪id"
      },
      "content": {
        "type": "object",
        "description": "分页数据",
        "properties": {
          "data": {
            "type": "array",
            "description": "收藏列表",
            "items": {
              "$ref": "#/$defs/MarkClientDTO"
            }
          },
          "totalCount": {
            "type": "number",
            "description": "总条数"
          },
          "currentPage": {
            "type": "number",
            "description": "当前页码"
          },
          "pageSize": {
            "type": "number",
            "description": "分页大小"
          }
        }
      }
    },
    "$defs": {
      "MarkClientDTO": {
        "type": "object",
        "description": "收藏记录",
        "properties": {
          "id": {
            "type": "number",
            "description": "主键"
          },
          "uid": {
            "type": "number",
            "description": "用户 uid"
          },
          "oid": {
            "type": "number",
            "description": "收藏对象 id"
          },
          "type": {
            "type": "number",
            "description": "收藏类型（MarkTypeEnum）"
          },
          "cid": {
            "type": "number",
            "description": "收藏分类 id"
          },
          "object": {
            "type": "object",
            "description": "收藏对象详情（AtaObjectClientDTO，需 selector）"
          },
          "markCategory": {
            "$ref": "#/$defs/MarkCategoryClientDTO",
            "description": "收藏分类（需 selector）"
          },
          "ctime": {
            "type": "string",
            "description": "创建时间"
          },
          "mtime": {
            "type": "string",
            "description": "更新时间"
          }
        }
      },
      "MarkCategoryClientDTO": {
        "type": "object",
        "description": "收藏分类",
        "properties": {
          "id": {
            "type": "number",
            "description": "主键"
          },
          "uid": {
            "type": "number",
            "description": "用户 uid"
          },
          "name": {
            "type": "string",
            "description": "分类名称"
          }
        }
      }
    }
  }
}
