{
  "version": 1,
  "id": "ata::mark-category-page-query-with-permission",
  "description": "分页查询当前用户的收藏标签信息，目前只有文章有收藏标签的概念",
  "javaMethod": "com.alibaba.atasuper.client.v2.mark.MarkCategoryClientService#pageQueryWithPermission",
  "inputSchema": {
    "description": "分页查询当前用户的收藏标签信息，目前只有文章有收藏标签的概念",
    "properties": {
      "fieldName_0": {
        "description": "查询收藏标签参数",
        "properties": {
          "currentPage": {
            "description": "当前页码",
            "type": "number"
          },
          "enableReturnCount": {
            "description": "是否返回总条数",
            "type": "boolean"
          },
          "nameLike": {
            "description": "名称模糊匹配",
            "type": "string"
          },
          "orderByList": {
            "items": {
              "description": "排序的字段信息",
              "properties": {
                "direction": {
                  "description": "排序;ASC 顺序;DESC 倒序;",
                  "enum": [
                    "ASC",
                    "DESC"
                  ],
                  "type": "string"
                },
                "orderConditionName": {
                  "description": "排序字段名;ID 主键;CTIME 创建时间;MTIME 修改时间;",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "pageSize": {
            "description": "分页大小",
            "type": "number"
          }
        },
        "type": "object"
      },
      "fieldName_1": {
        "description": "返回字段的选择器，可以返回一些额外字段，在选择器中没有的字段默认这个接口都会直接返回的，在用户没有特别说明的情况下选择器建议不传任何字段",
        "properties": {
          "empty": {
            "description": "占位字段，不用传",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "fieldName_0"
    ],
    "type": "object"
  },
  "outputSchema": {
    "description": "AtaPageResult<MarkCategoryClientDTO> 收藏分类分页",
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "是否成功"
      },
      "errorCode": {
        "type": "string",
        "description": "错误编码"
      },
      "errorMsg": {
        "type": "string",
        "description": "错误信息"
      },
      "traceId": {
        "type": "string",
        "description": "追踪id"
      },
      "content": {
        "type": "object",
        "description": "分页数据",
        "properties": {
          "data": {
            "type": "array",
            "description": "收藏分类列表",
            "items": {
              "$ref": "#/$defs/MarkCategoryClientDTO"
            }
          },
          "totalCount": {
            "type": "number",
            "description": "总条数"
          },
          "currentPage": {
            "type": "number",
            "description": "当前页码"
          },
          "pageSize": {
            "type": "number",
            "description": "分页大小"
          }
        }
      }
    },
    "$defs": {
      "MarkCategoryClientDTO": {
        "type": "object",
        "description": "收藏分类",
        "properties": {
          "id": {
            "type": "number",
            "description": "主键"
          },
          "uid": {
            "type": "number",
            "description": "用户 uid"
          },
          "name": {
            "type": "string",
            "description": "分类名称"
          }
        }
      }
    }
  }
}
